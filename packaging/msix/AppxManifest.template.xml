<?xml version="1.0" encoding="utf-8"?>
<!--
  결(Gyeol) MSIX 매니페스트 템플릿. pack-msix.ps1 이 @토큰@을 치환한다.
  · Store 제출 시 Identity Name/Publisher/PublisherDisplayName 은 Partner Center 예약값으로 교체.
  · 로컬 테스트(자체 서명) 시 Publisher 는 서명 인증서 Subject 와 일치해야 함(스크립트가 맞춰줌).
  · Full-trust Win32 앱: EntryPoint=Windows.FullTrustApplication + rescap:runFullTrust.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="@IDENTITY_NAME@"
            Publisher="@PUBLISHER@"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>README.md</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Gyeol" Executable="@EXE@" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="README.md"
        Description="경량 마크다운 리더 &amp; 에디터 · 100% 오프라인"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <!-- .md/.markdown 연결: Windows '연결 프로그램' 목록 등록 + 더블클릭 시 exe에 경로 전달 -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Markdown Document</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- 에이전트 브리지(MCP)를 터미널 PATH 에 노출한다: `readme-md.exe mcp`.
             패키지 안 exe 경로는 잠겨 있고 버전마다 바뀌므로 MCP 설정에 적을 수 없다 — 별칭이 유일한 길이다.

             **여기에 새 <Application> 을 만들지 않는다.** Application 하나가 곧 시작 메뉴 '모든 앱'
             항목 하나이고, AppListEntry="none" 으로 숨기면 Store 가 헤드리스 앱이라며 자동 거부한다.
             같은 계정의 Atlas 가 exe 를 늘렸다가 항목 셋이 되어 "눌러도 안 켜진다" 리뷰를 받았다.
             그래서 서버는 앱과 **같은 exe 의 한 모드**이고(md-reader.exe mcp), 별칭도 이 Application 이
             그대로 단다 → 앱 목록 항목 수는 그대로 하나다. 근거·실측 → docs/design/decisions/0002. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="@EXE@" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="readme-md.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
