{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* 플랫폼 구현 — 타입은 데스크톱 쪽으로 본다(웹 구현은 platform/conformance.ts 가 같은 모양인지 잰다).
       번들러 쪽 선택은 vite.config.ts 의 alias. */
    "paths": { "@platform": ["./app/platform/tauri.ts"] },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["app"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
